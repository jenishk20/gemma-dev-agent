import sqlite3
import os
from typing import List
from fastapi import FastAPI, Query, HTTPException, Request
from fastapi.responses import HTMLResponse
from pydantic import BaseModel
from jinja2 import Template

# Configuration
DB_PATH = "db.sqlite3"
PORT = 5000
HOST = "0.0.0.0"

app = FastAPI(title="Recommendation", version="1.0.11")

# Pydantic model for POST request
class Product(BaseModel):
    product_name: str
    tags: List[str]

# HTML Template for the GET response
HTML_TEMPLATE = """
<!DOCTYPE html>
<html>
<head>
    <title>Recommended Products</title>
    <style>
        body { font-family: sans-serif; margin: 40px; line-height: 1.6; }
        .product-card { border: 1px solid #ddd; padding: 10px; margin-bottom: 10px; border-radius: 5px; }
        .tag { background: #e0e0e0; padding: 2px 6px; border-radius: 3px; font-size: 0.8em; margin-right: 5px; }
        h1 { color: #333; }
    </style>
</head>
<body>
    <h1>Recommended Products</h1>
    {% if products %}
        {% for product in products %}
            <div class="product-card">
                <strong>{{ product.name }}</strong><br>
                Tags: {% for tag in product.tags %}<span class="tag">{{ tag }}</span>{% endfor %}
            </div>
        {% endfor %}
    {% else %}
        <p>No products found matching the provided tags.</p>
    {% endif %}
    <hr>
    <p><a href="/">Back to search</a></p>
</body>
</html>
"""

def get_db_connection():
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    return conn

def init_db():
    with get_db_connection() as conn:
        conn.execute("""
            CREATE TABLE IF NOT EXISTS products (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                name TEXT NOT NULL
            )
        """)
        conn.execute("""
            CREATE TABLE IF NOT EXISTS tags (
                product_id INTEGER,
                tag TEXT NOT NULL,
                FOREIGN KEY (product_id) REFERENCES products (id)
            )
        """)
        conn.commit()

@app.on_event("startup")
def startup_event():
    init_db()

@app.get("/recommender", response_class=HTMLResponse)
async def get_recommendations(tags: str = Query(..., description="Tags to search for separated by comma.")):
    # Split tags and clean whitespace
    search_tags = [t.strip() for t in tags.split(",") if t.strip()]
    
    if not search_tags:
        return HTMLResponse("<h1>No tags provided</h1>", status_code=200)

    try:
        with get_db_connection() as conn:
            # Use parameterized query to prevent SQL injection
            # We find products that have at least one of the tags in the list
            placeholders = ','.join(['?'] * len(search_tags))
            query = f"""
                SELECT p.name, GROUP_CONCAT(t.tag) as tags_list
                FROM products p
                JOIN tags t ON p.id = t.product_id
                WHERE p.id IN (
                    SELECT product_id FROM tags WHERE tag IN ({placeholders})
                )
                GROUP BY p.id
            """
            cursor = conn.execute(query, search_tags)
            rows = cursor.fetchall()
            
            products = []
            for row in rows:
                products.append({
                    "name": row["name"],
                    "tags": row["tags_list"].split(',')
                })
                
        template = Template(HTML_TEMPLATE)
        return template.render(products=products)
    except Exception as e:
        # Log error in real scenario
        raise HTTPException(status_code=500, detail="Internal Server Error")

@app.post("/recommender")
async def post_product(product: Product):
    if not product.product_name or not product.tags:
        raise HTTPException(status_code=400, detail="Invalid input: product_name and tags are required")

    try:
        with get_db_connection() as conn:
            cursor = conn.cursor()
            # Insert product
            cursor.execute("INSERT INTO products (name) VALUES (?)", (product.product_name,))
            product_id = cursor.lastrowid
            
            # Insert tags
            tag_data = [(product_id, tag.strip()) for tag in product.tags if tag.strip()]
            cursor.executemany("INSERT INTO tags (product_id, tag) VALUES (?, ?)", tag_data)
            
            conn.commit()
        return {"message": "Successful operation"}
    except Exception as e:
        raise HTTPException(status_code=500, detail="Internal Server Error")

if __name__ == "__main__":
    import uvicorn
    uvicorn.run(app, host=HOST, port=PORT)
