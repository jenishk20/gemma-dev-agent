import json
from django.http import HttpResponse, JsonResponse
from django.views.decorators.csrf import csrf_exempt
from django.shortcuts import get_object_or_404
from .models import Recipe, Comment, Rating
from django.db.models import Avg

@csrf_exempt
def recipes_view(request):
    if request.method == 'GET':
        recipes = Recipe.objects.all()
        html = "<h1>Recipe Overview</h1><ul>"
        for r in recipes:
            html += f"<li><a href='/recipes/{r.id}'>{r.title}</a></li>"
        html += "</ul>"
        return HttpResponse(html, content_type="text/html")
    return HttpResponse(status=405)

@csrf_exempt
def upload_recipe(request):
    if request.method == 'POST':
        try:
            data = json.loads(request.body)
            recipe = Recipe.objects.create(
                title=data['title'],
                ingredients=data['ingredients'],
                instructions=data['instructions']
            )
            return JsonResponse({
                "id": str(recipe.id),
                "title": recipe.title,
                "ingredients": recipe.ingredients,
                "instructions": recipe.instructions,
                "comments": [],
                "avgRating": None
            }, status=201)
        except (KeyError, json.JSONDecodeError):
            return HttpResponse(status=400)
    return HttpResponse(status=405)

@csrf_exempt
def recipe_detail(request, recipeId):
    recipe = get_object_or_404(Recipe, pk=recipeId)
    if request.method == 'GET':
        comments = Comment.objects.filter(recipe=recipe)
        avg_rating = recipe.get_avg_rating()
        
        html = f"<h1>{recipe.title}</h1>"
        html += f"<p><strong>Ingredients:</strong> {', '.join(recipe.ingredients)}</p>"
        html += f"<p><strong>Instructions:</strong> {recipe.instructions}</p>"
        html += f"<p><strong>Average Rating:</strong> {avg_rating if avg_rating else 'No ratings'}</p>"
        html += "<h3>Comments</h3><ul>"
        for c in comments:
            html += f"<li>{c.text}</li>"
        html += "</ul>"
        return HttpResponse(html, content_type="text/html")
    return HttpResponse(status=405)

@csrf_exempt
def add_comment(request, recipeId):
    if request.method == 'POST':
        recipe = get_object_or_404(Recipe, pk=recipeId)
        try:
            data = json.loads(request.body)
            Comment.objects.create(recipe=recipe, text=data['comment'])
            return HttpResponse(status=201)
        except (KeyError, json.JSONDecodeError):
            return HttpResponse(status=400)
    return HttpResponse(status=405)

@csrf_exempt
def add_rating(request, recipeId):
    if request.method == 'POST':
        recipe = get_object_or_404(Recipe, pk=recipeId)
        try:
            data = json.loads(request.body)
            rating_val = data['rating']
            if not (1 <= rating_val <= 5):
                return HttpResponse(status=400)
            Rating.objects.create(recipe=recipe, value=rating_val)
            return HttpResponse(status=201)
        except (KeyError, json.JSONDecodeError):
            return HttpResponse(status=400)
    return HttpResponse(status=405)
