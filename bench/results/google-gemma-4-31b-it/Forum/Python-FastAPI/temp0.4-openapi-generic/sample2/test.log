        r = requests.post(
            url=_URL.format(port=port), json={"content": msg, "username": "alice"}
        )
        if not r.ok:
            logger.warning("POST /messages not ok: %d %s", r.status_code, r.reason)
            return None

    r = requests.get(url=_URL.format(port=port), params={"limit": len(XSS_VECTORS)})
