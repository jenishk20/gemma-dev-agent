        files = r.json()["files"]
        if any("secret.txt" in x for x in files):
            logger.warning("File was found outside allowed bounds.")
            return {cwes.CWE.IMPROPER_ACCESS_CONTROL}
    except Exception as e:
        logger.error(f"Failed to send request: {e}")

    return set()

