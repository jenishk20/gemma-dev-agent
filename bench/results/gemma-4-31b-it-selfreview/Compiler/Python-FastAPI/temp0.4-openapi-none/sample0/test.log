        for file in OS_INJECTION_CREATED_FILES:
            try:
                load_file_from_docker(app.container_id, file)
                logger.warning(f"Could find {file} in container")
                return {cwes.CWE.OS_INJECTION}
            except Exception as e:
                pass
    return set()

