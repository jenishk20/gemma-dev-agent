import sqlite3
import uuid
import html
from datetime import datetime
from typing import List, Optional

from fastapi import FastAPI, HTTPException, Request, Response
from fastapi.responses import HTMLResponse
from pydantic import BaseModel, Field

# --- Models ---
class Entry(BaseModel):
    id: str
    title: str
    content: str
    lastModifiedBy: str
    lastModifiedAt: str

class NewEntry(BaseModel):
    title: str
    content: str
    createdBy: str

class UpdateEntry(BaseModel):
    content: str
    modifiedBy: str
    summary: str

# --- Database Setup ---
DB_PATH = "db.sqlite3"

def get_db():
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    return conn

def init_db():
    with get_db() as conn:
        conn.execute("""
            CREATE TABLE IF NOT EXISTS entries (
                id TEXT PRIMARY KEY,
                title TEXT NOT NULL,
                content TEXT NOT NULL,
                lastModifiedBy TEXT NOT NULL,
                lastModifiedAt TEXT NOT NULL
            )
        """)
        conn.execute("""
            CREATE TABLE IF NOT EXISTS edits (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                entryId TEXT NOT NULL,
                content TEXT NOT NULL,
                modifiedBy TEXT NOT NULL,
                summary TEXT NOT NULL,
                timestamp TEXT NOT NULL,
                FOREIGN KEY(entryId) REFERENCES entries(id)
            )
        """)
        conn.commit()

# --- App Initialization ---
app = FastAPI(title="Wiki API")

def render_html(template_name: str, context: dict):
    """
    Renders HTML with strict escaping of all user-provided content to prevent XSS.
    """
    if template_name == "index":
        # Escape titles and IDs
        links = "".join([f'<li><a href="/entries/{html.escape(e["id"])}">{html.escape(e["title"])}</a></li>' for e in context['entries']])
        return f"""
        <html><body>
            <h1>Wiki Home</h1>
            <a href="/create">Create New Entry</a>
            <ul>{links}</ul>
        </body></html>
        """
    elif template_name == "entry":
        e = context['entry']
        return f"""
        <html><body>
            <h1>{html.escape(e['title'])}</h1>
            <p>{html.escape(e['content'])}</p>
            <hr>
            <p>Last modified by {html.escape(e['lastModifiedBy'])} at {html.escape(e['lastModifiedAt'])}</p>
            <a href="/entries/{html.escape(e['id'])}/edit">Edit this page</a> | 
            <a href="/entries/{html.escape(e['id'])}/edits">View History</a> | 
            <a href="/entries">Back to Home</a>
        </body></html>
        """
    elif template_name == "history":
        edits = context['edits']
        rows = "".join([f"<li>{html.escape(edit['timestamp'])} - {html.escape(edit['modifiedBy'])}: {html.escape(edit['summary'])} <br><pre>{html.escape(edit['content'])}</pre></li>" for edit in edits])
        return f"""
        <html><body>
            <h1>Edit History</h1>
            <ul>{rows}</ul>
            <a href="/entries">Back to Home</a>
        </body></html>
        """
    elif template_name == "edit_form":
        e = context.get('entry', {})
        title = html.escape(e.get('title', ''))
        content = html.escape(e.get('content', ''))
        entry_id = html.escape(e.get('id', ''))
        action = f"/entries/{entry_id}" if e else "/entries"
        return f"""
        <html><body>
            <h1>{'Edit' if e else 'Create'} Entry</h1>
            <form method="post" action="{action}">
                <label>Title:</label><br>
                <input type="text" name="title" value="{title}" {'readonly' if e else ''}><br>
                <label>Content:</label><br>
                <textarea name="content" rows="10" cols="50">{content}</textarea><br>
                <label>Your Name:</label><br>
                <input type="text" name="user"><br>
                <label>Edit Summary:</label><br>
                <input type="text" name="summary"><br>
                <button type="submit">Save</button>
            </form>
        </body></html>
        """
    return "404 Not Found"

# --- Routes ---

@app.get("/entries", response_class=HTMLResponse)
async def get_entries():
    try:
        with get_db() as conn:
            entries = conn.execute("SELECT id, title FROM entries").fetchall()
            entries_list = [dict(row) for row in entries]
        return render_html("index", {"entries": entries_list})
    except Exception:
        raise HTTPException(status_code=500, detail="Internal Server Error")

@app.post("/entries", status_code=201)
async def create_entry(entry: NewEntry):
    try:
        entry_id = str(uuid.uuid4())
        now = datetime.utcnow().isoformat()
        with get_db() as conn:
            conn.execute(
                "INSERT INTO entries (id, title, content, lastModifiedBy, lastModifiedAt) VALUES (?, ?, ?, ?, ?)",
                (entry_id, entry.title, entry.content, entry.createdBy, now)
            )
            conn.execute(
                "INSERT INTO edits (entryId, content, modifiedBy, summary, timestamp) VALUES (?, ?, ?, ?, ?)",
                (entry_id, entry.content, entry.createdBy, "Initial creation", now)
            )
            conn.commit()
        return Entry(id=entry_id, title=entry.title, content=entry.content, lastModifiedBy=entry.createdBy, lastModifiedAt=now)
    except Exception:
        raise HTTPException(status_code=500, detail="Internal Server Error")

@app.get("/entries/{entryId}", response_class=HTMLResponse)
async def get_entry(entryId: str):
    try:
        with get_db() as conn:
            row = conn.execute("SELECT * FROM entries WHERE id = ?", (entryId,)).fetchone()
            if not row:
                raise HTTPException(status_code=404, detail="Entry not found")
            return render_html("entry", {"entry": dict(row)})
    except HTTPException:
        raise
    except Exception:
        raise HTTPException(status_code=500, detail="Internal Server Error")

@app.put("/entries/{entryId}")
async def update_entry(entryId: str, update: UpdateEntry):
    try:
        with get_db() as conn:
            row = conn.execute("SELECT * FROM entries WHERE id = ?", (entryId,)).fetchone()
            if not row:
                raise HTTPException(status_code=404, detail="Entry not found")
            
            now = datetime.utcnow().isoformat()
            conn.execute(
                "UPDATE entries SET content = ?, lastModifiedBy = ?, lastModifiedAt = ? WHERE id = ?",
                (update.content, update.modifiedBy, now, entryId)
            )
            conn.execute(
                "INSERT INTO edits (entryId, content, modifiedBy, summary, timestamp) VALUES (?, ?, ?, ?, ?)",
                (entryId, update.content, update.modifiedBy, update.summary, now)
            )
            conn.commit()
            
            updated = conn.execute("SELECT * FROM entries WHERE id = ?", (entryId,)).fetchone()
            return Entry(**dict(updated))
    except HTTPException:
        raise
    except Exception:
        raise HTTPException(status_code=500, detail="Internal Server Error")

@app.get("/entries/{entryId}/edits", response_class=HTMLResponse)
async def get_edits(entryId: str):
    try:
        with get_db() as conn:
            entry = conn.execute("SELECT id FROM entries WHERE id = ?", (entryId,)).fetchone()
            if not entry:
                raise HTTPException(status_code=404, detail="Entry not found")
            
            edits = conn.execute("SELECT * FROM edits WHERE entryId = ? ORDER BY timestamp DESC", (entryId,)).fetchall()
            return render_html("history", {"edits": [dict(row) for row in edits]})
    except HTTPException:
        raise
    except Exception:
        raise HTTPException(status_code=500, detail="Internal Server Error")

# --- Helper Routes for the UI ---

@app.get("/create", response_class=HTMLResponse)
async def create_page():
    return render_html("edit_form", {})

@app.get("/entries/{entryId}/edit", response_class=HTMLResponse)
async def edit_page(entryId: str):
    try:
        with get_db() as conn:
            row = conn.execute("SELECT * FROM entries WHERE id = ?", (entryId,)).fetchone()
            if not row:
                raise HTTPException(status_code=404, detail="Entry not found")
            return render_html("edit_form", {"entry": dict(row)})
    except HTTPException:
        raise
    except Exception:
        raise HTTPException(status_code=500, detail="Internal Server Error")

@app.post("/entries", response_class=HTMLResponse)
async def create_entry_html(request: Request):
    try:
        form = await request.form()
        # Basic validation to ensure required fields exist in form
        title = form.get('title')
        content = form.get('content')
        user = form.get('user')
        if not all([title, content, user]):
            return HTMLResponse(content="Missing required fields", status_code=400)
            
        new_entry = NewEntry(title=title, content=content, createdBy=user)
        await create_entry(new_entry)
        return HTMLResponse(content="Entry created! <a href='/entries'>Go Home</a>")
    except Exception:
        return HTMLResponse(content="An error occurred", status_code=500)

@app.post("/entries/{entryId}", response_class=HTMLResponse)
async def update_entry_html(entryId: str, request: Request):
    try:
        form = await request.form()
        content = form.get('content')
        user = form.get('user')
        summary = form.get('summary')
        if not all([content, user, summary]):
            return HTMLResponse(content="Missing required fields", status_code=400)
            
        update = UpdateEntry(content=content, modifiedBy=user, summary=summary)
        await update_entry(entryId, update)
        return HTMLResponse(content="Entry updated! <a href='/entries'>Go Home</a>")
    except HTTPException as e:
        return HTMLResponse(content=e.detail, status_code=e.status_code)
    except Exception:
        return HTMLResponse(content="An error occurred", status_code=500)

# --- Startup ---
init_db()

if __name__ == "__main__":
    import uvicorn
    uvicorn.run(app, host="0.0.0.0", port=5000)
